        {
          "name": "Create valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_DANG_Phở Bò Nam Định\",\n  \"description\": \"Công thức nấu phở gia truyền thơm ngon đậm vị\",\n  \"instructions\": \"Ninh xương bò 8 tiếng, chuẩn bị bánh phở và thịt tái, chan nước dùng sôi\",\n  \"prepTime\": 30,\n  \"cookTime\": 60,\n  \"servings\": 4,\n  \"cuisine\": \"Việt Nam\",\n  \"category\": \"Món nước\",\n  \"kcal\": 450,\n  \"protein\": 28.5,\n  \"carb\": 60.0,\n  \"fat\": 12.0,\n  \"difficulty\": \"Trung bình\",\n  \"mealSlots\": \"Sáng, Trưa\",\n  \"imageUrl\": \"https://example.com/pho.jpg\",\n  \"ingredients\": [\n    {\n      \"ingredientName\": \"Bánh phở\",\n      \"quantity\": 500.0,\n      \"unit\": \"g\",\n      \"note\": \"Bánh tươi\"\n    },\n    {\n      \"ingredientName\": \"Thịt bò thăn\",\n      \"quantity\": 300.0,\n      \"unit\": \"g\",\n      \"note\": \"Thái mỏng\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Recipe created successfully\", function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.id).to.not.be.undefined;",
                  "    pm.environment.set(\"createdRecipeId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
