	"item": [
		{
			"name": "00. [Auth] Đăng nhập lấy Bearer Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Login thành công 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"    const res = pm.response.json();",
							"    pm.environment.set(\"accessToken\", res.data.accessToken);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"minhanh\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "01. [TC12] Thêm nguyên liệu hợp lệ có dấu",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Lưu thành công nguyên liệu vào tủ lạnh\", function () {",
							"    const res = pm.response.json();",
							"    pm.expect(res.success).to.be.true;",
							"    pm.expect(res.data.name).to.include(\"Thịt ba chỉ heo\");",
							"    pm.expect(res.data.quantity).to.be.at.least(450);",
							"    pm.environment.set(\"createdItemId\", res.data.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Thịt ba chỉ heo\",\n  \"type\": \"Thịt\",\n  \"quantity\": 450,\n  \"unit\": \"g\",\n  \"kcal\": 350,\n  \"protein\": 28,\n  \"expiresAt\": \"2026-11-20\",\n  \"note\": \"Ngăn mát\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/fridge",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"fridge"
					]
				}
			}
		},
		{
			"name": "02. [TC13/TC17] Kiểm thử Tên rỗng & Chặn XSS Injection",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Hệ thống từ chối XSS và tên sai định dạng - HTTP 400\", function () {",
							"    pm.response.to.have.status(400);",
							"    const res = pm.response.json();",
							"    pm.expect(res.success).to.be.false;",
							"    pm.expect(res.message).to.include(\"Tên thực phẩm chỉ được chứa chữ cái\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"<script>alert('xss')</script>\",\n  \"quantity\": 200,\n  \"unit\": \"g\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/fridge",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"fridge"
					]
				}
			}
		},
