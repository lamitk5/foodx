		{
			"name": "04. [TC45] Cập nhật thông tin nguyên liệu (PUT Method)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Cập nhật thông tin nguyên liệu thành công\", function () {",
							"    const res = pm.response.json();",
							"    pm.expect(res.success).to.be.true;",
							"    pm.expect(res.message).to.eql(\"Đã cập nhật nguyên liệu thành công\");",
							"    pm.expect(res.data.name).to.include(\"Thịt bò Wagyu\");",
							"    pm.expect(res.data.quantity).to.eql(600);",
							"    pm.expect(res.data.note).to.eql(\"Hàng tươi vừa nhập\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Thịt bò Wagyu\",\n  \"type\": \"Thịt\",\n  \"quantity\": 600,\n  \"unit\": \"g\",\n  \"kcal\": 450,\n  \"protein\": 32,\n  \"expiresAt\": \"2026-12-01\",\n  \"note\": \"Hàng tươi vừa nhập\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/fridge/{{createdItemId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"fridge",
						"{{createdItemId}}"
					]
				}
			}
		},
