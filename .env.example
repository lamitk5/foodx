# ============================================================================
# FoodX — mẫu biến môi trường cho Docker Compose
# ============================================================================
# Sao chép thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
# Docker Compose tự đọc file `.env` cùng thư mục. KHÔNG commit file `.env`.
#
# Nếu bỏ qua bước này, hệ thống vẫn chạy được bằng giá trị mặc định dành cho DEV
# (đã ghi công khai trong repo) — TUYỆT ĐỐI không dùng cho production.
# ============================================================================

# Mật khẩu tài khoản root của MySQL (chỉ dùng để quản trị container)
MYSQL_ROOT_PASSWORD=root

# Khoá ký JWT — PHẢI giống nhau ở mọi service, tối thiểu 32 byte.
# Sinh khoá: openssl rand -base64 48
APP_JWT_SECRET=dev-super-secret-key-please-change-this-key-32bytes!!
APP_JWT_ISSUER=foodx

# Token chia sẻ cho cổng nội bộ /internal/** giữa các service
FOODX_INTERNAL_TOKEN=foodx-internal-dev-token

# Khoá nhà cung cấp LLM (ai-service). Để trống thì ai-service chạy chế độ dữ liệu mẫu.
GROQ_API_KEY=
GEMINI_API_KEY=

# Lưu ý: tài khoản MySQL của từng service (foodx_user, foodx_inventory, ...) dùng
# mật khẩu dev cố định `foodx_dev_pw` được tạo bởi db/init/00-create-databases.sql.
# Khi triển khai thật: tạo tài khoản riêng với mật khẩu ngẫu nhiên, cấp qua
# SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD cho từng service.
