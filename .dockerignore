# Ngữ cảnh build được gửi lên Docker daemon — giữ càng nhỏ càng tốt.
# Không có file này thì `target/` (hàng trăm MB) và `node_modules/` cũng bị gửi lên.

.git
.gitignore
.github

# Kết quả build: bỏ class/test, giữ jar để image chỉ COPY (Maven không chạy trong Docker)
**/target/**
!api-gateway/target/
!api-gateway/target/*.jar
!services/user-service/target/
!services/user-service/target/*.jar
!services/inventory-service/target/
!services/inventory-service/target/*.jar
!services/recipe-service/target/
!services/recipe-service/target/*.jar
!services/plan-shopping-service/target/
!services/plan-shopping-service/target/*.jar
!services/ai-service/target/
!services/ai-service/target/*.jar
!services/social-stats-service/target/
!services/social-stats-service/target/*.jar

# IDE / công cụ
.idea
.vscode
*.iml
.playwright-cli

# Node (chỉ dùng cho script test UI, không thuộc backend)
node_modules
package.json
package-lock.json

# Dữ liệu & tài liệu không cần cho image
logs
uploads
scratch_img
scripts
tests
tools
katalon
db
*.md
*.docx
*.py
*.log
