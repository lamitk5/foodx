<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description></description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description>Base URL of FoodX Application</description>
      <initValue>'http://localhost:8080'</initValue>
      <name>BASE_URL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Default Wait Timeout in seconds</description>
      <initValue>10</initValue>
      <name>DEFAULT_TIMEOUT</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Test User Username</description>
      <initValue>'testuser_katalon'</initValue>
      <name>TEST_USERNAME</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Test User Email</description>
      <initValue>'katalon_tester@foodx.com'</initValue>
      <name>TEST_EMAIL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Test User Password</description>
      <initValue>'Password123!'</initValue>
      <name>TEST_PASSWORD</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
